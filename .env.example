# Dify Cloud API endpoint. If you use self-hosted Dify, replace this with your own /v1 endpoint.
DIFY_BASE_URL=https://api.dify.ai/v1

# Optional fallback: one Dify App API Key shared by all modules.
DIFY_API_KEY=

# Optional module-specific Dify App API Keys.
# Fill these if you created separate Dify Agents/Chatflows for each page.
DIFY_API_KEY_ONED=
DIFY_API_KEY_STM=
DIFY_API_KEY_ALPHA=
DIFY_API_KEY_FLASH=
DIFY_API_KEY_RTD=

# DeepSeek API Key is configured inside Dify, not in this platform.
